From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: divaft <divaft@local>
Subject: [PATCH] g2-android: build FEXCore/Common for Android (bionic,libc++); FEXCore-only harness; getdents64 shim (rebased FEX-2611.1)

---
diff --git a/FEXCore/Source/Utils/FileUtils.cpp b/FEXCore/Source/Utils/FileUtils.cpp
index d3e62cacd..88f6ea118 100644
--- a/FEXCore/Source/Utils/FileUtils.cpp
+++ b/FEXCore/Source/Utils/FileUtils.cpp
@@ -9,6 +9,13 @@
 #include <dirent.h>
 #include <fcntl.h>
 #include <unistd.h>
+#ifdef __ANDROID__
+#include <sys/syscall.h>
+// g2-android: bionic 不声明 getdents64，经 syscall 提供
+static inline ssize_t getdents64(int fd, void* buf, size_t nbytes) {
+  return static_cast<ssize_t>(syscall(SYS_getdents64, fd, buf, nbytes));
+}
+#endif
 #else
 #include <windows.h>
 #include <winnt.h>

-- 
2.43.0
