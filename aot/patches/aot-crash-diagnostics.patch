diff --git a/cpu/guest_cpu_aot.cpp b/cpu/guest_cpu_aot.cpp
index 5d98660..b6ffdaa 100644
--- a/cpu/guest_cpu_aot.cpp
+++ b/cpu/guest_cpu_aot.cpp
@@ -1069,6 +1069,39 @@ __attribute__((visibility("default"))) void bbaot_crash_report(const void* ucont
     std::fprintf(stderr, "AOT: fault at host pc %p (%s), guest rsp %#llx, rip %#llx, depth %u\n", reinterpret_cast<void*>(pc),
                  pc >= E.so_lo && pc < E.so_hi ? "in a unit" : InCode(pc) ? "in guest code" : "elsewhere",
                  (unsigned long long)t->s->gregs[RSP], (unsigned long long)t->s->rip, t->depth);
+    {
+        const uint64_t* g = t->s->gregs;
+        std::fprintf(stderr, "AOT: gregs: rax=%llx rcx=%llx rdx=%llx rbx=%llx rsp=%llx rbp=%llx rsi=%llx rdi=%llx\n",
+                     (unsigned long long)g[0],(unsigned long long)g[1],(unsigned long long)g[2],(unsigned long long)g[3],
+                     (unsigned long long)g[4],(unsigned long long)g[5],(unsigned long long)g[6],(unsigned long long)g[7]);
+        std::fprintf(stderr, "AOT:       r8=%llx r9=%llx r10=%llx r11=%llx r12=%llx r13=%llx r14=%llx r15=%llx srip=%llx\n",
+                     (unsigned long long)g[8],(unsigned long long)g[9],(unsigned long long)g[10],(unsigned long long)g[11],
+                     (unsigned long long)g[12],(unsigned long long)g[13],(unsigned long long)g[14],(unsigned long long)g[15],
+                     (unsigned long long)t->s->rip);
+        // 内存探针：dump rbx/rdi 对象及其首成员指向的结构（getter 返回 null 诊断）
+        auto probe = [&](const char* tag, uint64_t addr) {
+            if (addr < 0x10000 || addr > 0x8000000000ull) return;
+            const uint64_t* p = reinterpret_cast<const uint64_t*>(addr);
+            std::fprintf(stderr, "AOT: mem@%s %llx:", tag, (unsigned long long)addr);
+            for (int i = 0; i < 8; ++i) std::fprintf(stderr, " %llx", (unsigned long long)p[i]);
+            std::fprintf(stderr, "\n");
+            uint64_t q = p[0];
+            if (q >= 0x10000 && q < 0x8000000000ull) {
+                const uint64_t* r = reinterpret_cast<const uint64_t*>(q);
+                std::fprintf(stderr, "AOT:   [%s]=%llx ->", tag, (unsigned long long)q);
+                for (int i = 0; i < 4; ++i) std::fprintf(stderr, " %llx", (unsigned long long)r[i]);
+                std::fprintf(stderr, " | +10=%llx +a0=%llx +a8=%llx\n",
+                             (unsigned long long)r[2], (unsigned long long)r[20], (unsigned long long)r[21]);
+            }
+        };
+        probe("rbx", g[3]); probe("rdi", g[7]);
+#if defined(__aarch64__) && defined(__linux__)
+        const auto& mc = static_cast<const ucontext_t*>(ucontext)->uc_mcontext;
+        std::fprintf(stderr, "AOT: hostregs:");
+        for (int i = 0; i < 31; ++i) std::fprintf(stderr, " x%d=%llx", i, (unsigned long long)mc.regs[i]);
+        std::fprintf(stderr, " sp=%llx pc=%llx\n", (unsigned long long)mc.sp, (unsigned long long)mc.pc);
+#endif
+    }
     if (pc >= E.so_lo && pc < E.so_hi) {
         auto at = std::upper_bound(E.by_address.begin(), E.by_address.end(), pc, [](uintptr_t v, const Engine::Where& w) { return v < w.fn; });
         if (at != E.by_address.begin()) std::fprintf(stderr, "AOT: unit +%#x, offset %#llx in it\n", (at - 1)->vaddr, (unsigned long long)(pc - (at - 1)->fn));
